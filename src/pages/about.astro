---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import { Icon } from 'astro-icon/components';

const formation = [
	{
		niveau: 'Bac+5',
		titre: 'Mastère Développeur Manager Full Stack',
		lieu: 'EFREI, en alternance',
		dates: '2024 - 2026',
	},
	{
		niveau: 'Bac+3',
		titre: "Bachelor Concepteur Développeur d'Applications",
		lieu: 'EFREI',
		dates: '2023 - 2024',
	},
	{
		niveau: 'Bac+2',
		titre: 'BTS SNIR, option Informatique et Réseaux',
		lieu: 'Systèmes Numériques',
		dates: '2021 - 2023',
	},
	{
		niveau: 'Bac',
		titre: 'Bac général',
		lieu: "Spécialités Sciences de l'ingénieur et SES",
		dates: '2019 - 2020',
	},
];

// Badges façon README GitHub : logo + couleur officielle de chaque techno
type Badge = { nom: string; icone: string; fond: string; texte?: string };

const stack: { categorie: string; items: Badge[] }[] = [
	{
		categorie: 'Langages et frameworks',
		items: [
			{ nom: 'PHP', icone: 'simple-icons:php', fond: '#777BB4' },
			{ nom: 'JavaScript', icone: 'simple-icons:javascript', fond: '#F7DF1E', texte: '#000' },
			{ nom: 'TypeScript', icone: 'simple-icons:typescript', fond: '#3178C6' },
			{ nom: 'React Native', icone: 'simple-icons:react', fond: '#20232A', texte: '#61DAFB' },
			{ nom: 'Expo', icone: 'simple-icons:expo', fond: '#000020' },
			{ nom: 'Node.js', icone: 'simple-icons:nodedotjs', fond: '#5FA04E' },
			{ nom: 'Express', icone: 'simple-icons:express', fond: '#353535' },
			{ nom: 'Python', icone: 'simple-icons:python', fond: '#3776AB' },
			{ nom: 'Pandas', icone: 'simple-icons:pandas', fond: '#150458' },
			{ nom: 'HTML', icone: 'simple-icons:html5', fond: '#E34F26' },
			{ nom: 'CSS', icone: 'simple-icons:css', fond: '#663399' },
			{ nom: 'Tailwind', icone: 'simple-icons:tailwindcss', fond: '#06B6D4' },
		],
	},
	{
		categorie: 'Bases de données',
		items: [
			{ nom: 'SQL', icone: 'simple-icons:mysql', fond: '#4479A1' },
			{ nom: 'MongoDB', icone: 'simple-icons:mongodb', fond: '#47A248' },
		],
	},
	{
		categorie: 'Qualité et déploiement',
		items: [
			{ nom: 'Git', icone: 'simple-icons:git', fond: '#F05032' },
			{ nom: 'Docker', icone: 'simple-icons:docker', fond: '#2496ED' },
			{ nom: 'Cypress', icone: 'simple-icons:cypress', fond: '#69D3A7', texte: '#04201A' },
			{ nom: 'Jenkins', icone: 'simple-icons:jenkins', fond: '#D24939' },
			{ nom: 'Artifactory', icone: 'simple-icons:jfrog', fond: '#40BE46' },
			{ nom: 'Power BI', icone: 'simple-icons:powerbi', fond: '#F2C811', texte: '#000' },
		],
	},
	{
		categorie: 'IA',
		items: [
			{ nom: 'Claude Code', icone: 'simple-icons:claude', fond: '#D97757' },
			{ nom: 'GitHub Copilot', icone: 'simple-icons:githubcopilot', fond: '#24292F' },
			{ nom: 'Ollama', icone: 'simple-icons:ollama', fond: '#3F3F46' },
			{ nom: 'MCP', icone: 'simple-icons:modelcontextprotocol', fond: '#1F2937' },
			{ nom: 'RAG', icone: 'mdi:database-search', fond: '#6E40C9' },
			{ nom: 'Embeddings', icone: 'mdi:vector-triangle', fond: '#0E7490' },
		],
	},
];

const qualites = [
	'Autonomie',
	'Curiosité',
	'Persévérance',
	'Adaptabilité',
	'Rigueur',
	"Esprit d'équipe",
	'Force de proposition',
	
];
---

<BaseLayout
	title="À propos | Rayane B"
	description="Développeur full-stack (PHP, React Native, Node.js), trois ans d'alternance dont deux chez SNCF Réseau. Disponible pour un CDI en Île-de-France."
>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="À propos de moi"
				tagline="Développeur full-stack, trois ans d'alternance entre l'EFREI et le terrain. Voilà qui je suis."
			>
				<img
					width="1553"
					height="873"
					src="/assets/rayane_rando.jpg"
					alt="Rayane en randonnée"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Mon parcours</h2>
				<div class="content">
					<p class="dispo">
						<span class="dot" aria-hidden="true"></span>
						Disponible pour un CDI en Île-de-France
					</p>

					<p>
						Je suis développeur full-stack et je sors d'un Mastère Développeur Manager Full Stack à l'EFREI,
						que j'ai fait en alternance. Ça fait trois ans que j'alterne entre l'école et le terrain, et
						honnêtement, c'est le terrain qui m'a le plus appris.
					</p>

					<div class="xp">
						<h3>SNCF Réseau <span>2 ans</span></h3>
						<p>
							J'ai développé seul une <strong>application web nationale de gestion du patrimoine télécom</strong>,
							utilisée tous les jours par une quinzaine d'ingénieurs. Je m'en suis occupé de bout en bout : front,
							back, base de données, déploiement et maintien en production. Derrière, il y a une vraie chaîne de
							qualité (tests Cypress, intégration continue Jenkins, Docker). J'y ai aussi écrit des scripts Python
							qui traitent des fichiers de plusieurs dizaines de milliers de lignes et alimentent des tableaux Power BI.
						</p>
					</div>

					<div class="xp">
						<h3>Ummanité, puis bénévolat <span>depuis 3 ans</span></h3>
						<p>
							Avant la SNCF, j'ai passé un an chez Ummanité, une association qui vient en aide aux personnes
							sans-abri. J'y ai démarré une <strong>application mobile</strong> que je n'ai pas eu le temps de
							terminer. Le projet me tenait à cœur, alors je continue de la développer bénévolement sur mon temps
							perso. React Native côté mobile, une API Node/Express que j'ai conçue de A à Z, MongoDB, Cloudinary
							pour les images. Elle permet de scanner des documents avec de l'OCR et de suivre un véhicule en GPS
							en temps réel pour optimiser les tournées.
						</p>
					</div>

					<p>
						J'utilise l'IA tous les jours (Claude Code, Copilot, RAG, MCP), mais avec du recul. Sur cette appli,
						l'OCR généré avec l'IA inventait du texte quand une photo était illisible au lieu de renvoyer une
						erreur. J'ai ajouté un contrôle de qualité de l'image en amont :
						<strong>tester ce que l'IA ne testait pas</strong>. C'est un peu comme ça que je vois le métier
						aujourd'hui.
					</p>

					<p>En dehors du code, il y a la rando, le sport, les jeux vidéo et les mangas.</p>
				</div>
			</section>

			<section>
				<h2 class="section-title">Formation</h2>
				<div class="content">
					<ol class="timeline">
						{formation.map((f, i) => (
							<li class:list={['etape', { recente: i === 0 }]}>
								<span class="point" aria-hidden="true"></span>
								<div class="carte">
									<div class="entete">
										<span class="dates">{f.dates}</span>
										<span class="niveau">{f.niveau}</span>
									</div>
									<p class="titre">{f.titre}</p>
									<p class="meta">{f.lieu}</p>
								</div>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section>
				<h2 class="section-title">Stack</h2>
				<div class="content stack-groups">
					{stack.map((groupe) => (
						<div>
							<h3 class="categorie">{groupe.categorie}</h3>
							<ul class="badges">
								{groupe.items.map((item) => (
									<li style={`--fond: ${item.fond}; --texte: ${item.texte ?? '#fff'}`}>
										<Icon name={item.icone} aria-hidden="true" />
										{item.nom}
									</li>
								))}
							</ul>
						</div>
					))}
					<div>
						<h3 class="categorie">Ce qui me caractérise</h3>
						<ul class="qualites">
							{qualites.map((q) => <li>{q}</li>)}
						</ul>
					</div>
				</div>
			</section>

			<section>
				<h2 class="section-title">Ma personnalité</h2>
				<div class="content">
					<p>
						Je suis un touche-à-tout. J'aime découvrir des choses nouvelles, surtout dans des domaines que je ne
						connais pas. J'appelle ça la <strong>pensée en arborescence</strong> : une question en amène une
						autre, et je me retrouve à lire de la sociologie, de la psychologie, de l'histoire, ou
						de la biologie. J'aime aussi les débats et les échanges, apprendre de l'expérience des autres et
						partager la mienne.
					</p>
					<p>
						C'est ce qui m'a aidé à rentrer dans le ferroviaire à la SNCF, un domaine très technique dont j'ai
						fini par faire le sujet de mon mémoire.
					</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
		width: 100%;
		max-width: 500px;
		height: auto;
		display: block;
		margin-left: auto;
		margin-right: auto;
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		line-height: 1.7;
	}

	.content p {
		margin: 0;
	}

	.content strong {
		color: var(--gray-0);
		font-weight: 600;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	/* Badge de disponibilité */
	.dispo {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		align-self: flex-start;
		padding: 0.4rem 1rem;
		border: 1px solid var(--gray-800);
		border-radius: 999rem;
		background-color: var(--gray-999);
		color: var(--gray-0);
		font-size: var(--text-sm);
		font-weight: 500;
		box-shadow: var(--shadow-sm);
	}

	.dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background-color: #22c55e;
		box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
	}

	/* Blocs d'expérience */
	.xp {
		padding-left: 1.25rem;
		border-left: 2px solid var(--accent-regular);
	}

	.xp h3 {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
		margin: 0 0 0.4rem;
		font-size: var(--text-lg);
		color: var(--gray-0);
	}

	.xp h3 span {
		font-size: var(--text-sm);
		font-weight: 400;
		color: var(--gray-400);
	}

	/* Frise de formation */
	.timeline {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	/* Ligne verticale qui relie les étapes */
	.timeline::before {
		content: '';
		position: absolute;
		top: 1.5rem;
		bottom: 1.5rem;
		left: 0.45rem;
		width: 2px;
		background: linear-gradient(var(--accent-regular), var(--gray-800));
	}

	.etape {
		position: relative;
		padding-left: 2.25rem;
	}

	.point {
		position: absolute;
		top: 1.35rem;
		left: 0;
		width: 1rem;
		height: 1rem;
		border: 2px solid var(--accent-regular);
		border-radius: 50%;
		background-color: var(--gray-999);
	}

	.recente .point {
		background-color: var(--accent-regular);
		box-shadow: 0 0 0 4px var(--accent-subtle-overlay);
	}

	.carte {
		padding: 1rem 1.25rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background-color: var(--gray-999);
		box-shadow: var(--shadow-sm);
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.carte:hover {
		transform: translateX(4px);
		border-color: var(--accent-regular);
	}

	.recente .carte {
		border-color: var(--accent-regular);
	}

	.entete {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.25rem;
	}

	.dates {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--accent-regular);
	}

	.niveau {
		padding: 0.1rem 0.6rem;
		border-radius: 999rem;
		background-color: var(--accent-subtle-overlay);
		color: var(--accent-regular);
		font-size: var(--text-sm);
		font-weight: 600;
	}

	.titre {
		color: var(--gray-0);
		font-weight: 600;
		line-height: 1.4;
	}

	.meta {
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	/* Stack en badges colorés */
	.stack-groups {
		gap: 1.5rem;
	}

	.categorie {
		margin: 0 0 0.6rem;
		font-size: var(--text-base);
		font-weight: 600;
		color: var(--gray-0);
	}

	.badges,
	.qualites {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.badges li {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0.75rem;
		border-radius: 0.5rem;
		background-color: var(--fond);
		color: var(--texte);
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: 1.4;
		box-shadow: var(--shadow-sm);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.badges li:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}

	.badges :global(svg) {
		width: 1.1em;
		height: 1.1em;
		flex-shrink: 0;
	}

	.qualites li {
		padding: 0.35rem 0.9rem;
		border-radius: 999rem;
		background-color: var(--accent-subtle-overlay);
		color: var(--accent-regular);
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: 1.4;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>